{
  "name": "footprints-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Footprints — vi 的生活与技术博客",
  "scripts": {
    "build": "node scripts/run-framework.mjs build",
    "build:static": "node scripts/build.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/interactions.test.mjs scripts/server.test.mjs scripts/editor.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "markdown-it": "^14.1.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": { "sharp": "0.35.4" }
  }
}
